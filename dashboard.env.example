# Configuracion del dashboard de backups. Copiar a dashboard.env (ignorado por git):
#   cp dashboard.env.example dashboard.env
# y correr, dentro de un Debian fresco y como root:
#   bash scripts/bootstrap-dashboard.sh
#
# Lo usa tambien el colector en runtime: el bootstrap lo instala como
# /etc/backup-dashboard/dashboard.env (0600). IPs de documentacion (RFC 5737).

# --- PVE (cualquier nodo del cluster) ---
PVE_HOST=192.0.2.11
PVE_PORT=8006
# Token read-only con rol PVEAuditor en /. Formato: usuario@realm!nombre
PVE_TOKEN_ID=dashboard@pve!collector
PVE_TOKEN_SECRET=

# --- PBS ---
PBS_HOST=192.0.2.20
PBS_PORT=8007
# Token read-only con rol DatastoreAudit en /datastore/<store>.
PBS_TOKEN_ID=dashboard@pbs!collector
PBS_TOKEN_SECRET=
PBS_STORE=backups

# --- Umbrales ---
# Sin comentarios al final de linea: systemd (EnvironmentFile) los toma como
# parte del valor.
# Ultimo backup mas nuevo que esto (horas) = OK.
OK_HOURS=26
# Hasta esto (dias) = atencion; mas viejo = viejo.
WARN_DAYS=3
# Frecuencia del timer y del auto-refresh de la pagina (minutos).
REFRESH_MINUTES=5

# --- TLS (por API, de mas a menos estricto; vacio = no verifica) ---
# Path dentro del CT a un CA contra el que validar la cadena.
#   PVE: copia de /etc/pve/pve-root-ca.pem   PBS: copia de /etc/proxmox-backup/proxy.pem
PVE_CA_FILE=
PBS_CA_FILE=
# O un fingerprint SHA-256 fijo (con o sin ":").
PVE_FINGERPRINT=
PBS_FINGERPRINT=

# --- Salida ---
OUTPUT=/var/www/html/index.html
