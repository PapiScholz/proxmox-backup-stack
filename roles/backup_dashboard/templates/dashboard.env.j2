# {{ ansible_managed }}
# Config no secreta del colector. Los secretos de los tokens estan en
# pve-token.env y pbs-token.env, junto a este archivo.
PVE_HOST={{ dashboard_pve_host }}
PVE_PORT={{ dashboard_pve_port }}
PVE_TOKEN_ID={{ dashboard_pve_user }}!{{ dashboard_token_name }}
PBS_HOST={{ dashboard_pbs_host }}
PBS_PORT={{ dashboard_pbs_port }}
PBS_TOKEN_ID={{ dashboard_pbs_user }}!{{ dashboard_token_name }}
PBS_STORE={{ dashboard_pbs_store }}
OK_HOURS={{ dashboard_ok_hours }}
WARN_DAYS={{ dashboard_warn_days }}
REFRESH_MINUTES={{ dashboard_refresh_minutes }}
PVE_CA_FILE={{ '/etc/backup-dashboard/pve-root-ca.pem' if dashboard_verify_with_ca | bool else '' }}
PBS_CA_FILE={{ '/etc/backup-dashboard/pbs-proxy.pem' if dashboard_verify_with_ca | bool else '' }}
PVE_FINGERPRINT={{ dashboard_pve_fingerprint }}
PBS_FINGERPRINT={{ dashboard_pbs_fingerprint }}
OUTPUT=/var/www/html/index.html
